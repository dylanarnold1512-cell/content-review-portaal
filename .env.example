# Kopieer dit bestand naar .env voor lokaal draaien, of zet dezelfde namen
# als environment variables in Render.

# Willekeurige lange string, voor het ondertekenen van sessie-cookies.
SESSION_SECRET=

# Eén Notion-integratietoken per klant-werkruimte (zie README voor hoe je
# deze aanmaakt in Notion).
NOTION_TOKEN_BASECAMP=
NOTION_TOKEN_PPE=

# Eén gedeeld wachtwoord per klant, voor de reviewer(s) van die klant.
PORTAL_PASSWORD_BASECAMP=
PORTAL_PASSWORD_PPE=

# Advertisr's eigen interne Notion-integratie (werkruimte "Advertisr AI OS"),
# los van de klant-werkruimtes hierboven. Gebruikt door /admin (Portaal
# Instellingen, Klant Intake) EN door LP Fabriek (Landingspagina's) — zie
# README, "Klantinstellingen aan/uit zetten" en "LP Fabriek".
NOTION_TOKEN_ADMIN=
# Eén los wachtwoord voor het instellingenpaneel op /admin.
ADMIN_PASSWORD=

# LP Fabriek (/lp): eigen los wachtwoord, alleen voor Dylan en Marc — geen
# hergebruik van ADMIN_PASSWORD. Zie besluiten.md "Portaal: een app, twee
# zones" en README, "LP Fabriek".
LP_PASSWORD=
# Optioneel: alleen zetten als de "Landingspagina's"-database ooit verplaatst
# of opnieuw aangemaakt wordt. Standaard zit het juiste ID al hardcoded in
# src/lp/notion.js.
LP_LANDINGSPAGINAS_DATABASE_ID=
# Zelfde soort optionele override, maar dan voor de "Sjablonen"-database
# (blueprints als data, zie src/lp/templates.js). Standaard zit het juiste
# ID al hardcoded in dat bestand.
LP_SJABLONEN_DATABASE_ID=

# WordPress applicatiewachtwoorden per LP Fabriek-klant (zie
# src/lp/clients/<klant>/profile.js voor welke env var-namen bij welke klant
# horen).
WP_URL_ROOTS=
WP_USERNAME_ROOTS=
WP_APP_PASSWORD_ROOTS=

# Kennisdocument-tabblad: leest en schrijft rechtstreeks naar de n8n Data
# Table "Kennisdocumenten" (dezelfde tabel die de blog-generatie-workflows
# gebruiken), via de n8n public API. Aanmaken: n8n → instellingen → n8n API →
# nieuwe API key. Zie README, "Kennisdocument-tabblad".
N8N_API_KEY=
# Optioneel: alleen zetten als de n8n-omgeving ooit verhuist. Standaard staat
# de juiste waarde al hardcoded in src/services/kennisdocument.js.
N8N_BASE_URL=
# Optioneel: alleen zetten als de "Kennisdocumenten"-tabel ooit verplaatst of
# opnieuw aangemaakt wordt. Standaard staat het juiste ID al hardcoded.
N8N_KENNISDOCUMENTEN_TABLE_ID=

PORT=3000
